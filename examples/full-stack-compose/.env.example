# Environment Configuration for BYoAI Full Stack Compose Example

# LLM API Key (Required: Gemini or your configured model provider)
GEMINI_API_KEY=your-gemini-api-key-here

# Computer Controller Security Token (defaults to dev-computer-key)
CC_API_KEY=dev-computer-key

# Chat UI Session Secret (32+ character random string in production)
SESSION_SECRET=dev-session-secret-key-at-least-32-bytes!

{
    "name": "@byo-ai-agent-platform/core",
    "version": "1.0.2",
    "description": "Core runtime, agent contracts, models, tools, observers, and storage interfaces for the BYoAI Agent Platform",
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "bun build --root ./src ./src/index.ts ./src/agents/index.ts ./src/computer/index.ts ./src/config/index.ts ./src/errors/index.ts ./src/logger/index.ts ./src/models/index.ts ./src/skills/index.ts ./src/tools/index.ts --outdir ./dist --target=bun && bunx tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist && find dist -name '*.test.d.ts' -delete"
    },
    "devDependencies": {
        "@modelcontextprotocol/server": "^2.0.0",
        "@types/adm-zip": "^0.5.8",
        "@types/bun": "latest",
        "@types/express": "^5.0.6",
        "@types/winston": "^2.4.4",
        "express": "^5.0.1"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.124.0",
        "@apidevtools/json-schema-ref-parser": "^16.0.2",
        "@bufbuild/buf": "^1.72.0",
        "@bufbuild/protobuf": "^2.14.1",
        "@bufbuild/protoc-gen-es": "^2.14.1",
        "@connectrpc/connect": "^2.2.0",
        "@connectrpc/connect-node": "^2.2.0",
        "@connectrpc/validate": "^0.2.0",
        "@google/genai": "^2.21.0",
        "@modelcontextprotocol/client": "^2.0.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
        "@opentelemetry/resources": "^2.12.0",
        "@opentelemetry/sdk-trace-base": "^2.12.0",
        "@opentelemetry/sdk-trace-node": "^2.12.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@scalar/openapi-upgrader": "^0.2.15",
        "adm-zip": "^0.6.0",
        "dotenv": "^17.4.2",
        "openai": "^7.13.0",
        "winston": "^3.19.0",
        "zod": "^4.6.1"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./models": {
            "types": "./dist/models/index.d.ts",
            "import": "./dist/models/index.js",
            "default": "./dist/models/index.js"
        },
        "./models/*": "./src/models/*",
        "./agents": {
            "types": "./dist/agents/index.d.ts",
            "import": "./dist/agents/index.js",
            "default": "./dist/agents/index.js"
        },
        "./agents/*": "./src/agents/*",
        "./skills": {
            "types": "./dist/skills/index.d.ts",
            "import": "./dist/skills/index.js",
            "default": "./dist/skills/index.js"
        },
        "./skills/*": "./src/skills/*",
        "./tools": {
            "types": "./dist/tools/index.d.ts",
            "import": "./dist/tools/index.js",
            "default": "./dist/tools/index.js"
        },
        "./tools/*": "./src/tools/*",
        "./config": {
            "types": "./dist/config/index.d.ts",
            "import": "./dist/config/index.js",
            "default": "./dist/config/index.js"
        },
        "./config/*": "./src/config/*",
        "./computer": {
            "types": "./dist/computer/index.d.ts",
            "import": "./dist/computer/index.js",
            "default": "./dist/computer/index.js"
        },
        "./computer/*": "./src/computer/*",
        "./errors": {
            "types": "./dist/errors/index.d.ts",
            "import": "./dist/errors/index.js",
            "default": "./dist/errors/index.js"
        },
        "./errors/*": "./src/errors/*",
        "./logger": {
            "types": "./dist/logger/index.d.ts",
            "import": "./dist/logger/index.js",
            "default": "./dist/logger/index.js"
        },
        "./logger/*": "./src/logger/*",
        "./*": "./src/*"
    }
}

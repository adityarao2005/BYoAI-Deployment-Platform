{
    "name": "@byo-ai-agent-platform/sqlite",
    "version": "1.0.2",
    "description": "SQLite persistence adapter for the BYoAI Agent Platform",
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "bun build ./src/index.ts --outdir ./dist --target=bun && bunx tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist && find dist -name '*.test.d.ts' -delete"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@byo-ai-agent-platform/core": "workspace:*",
        "drizzle-orm": "^0.45.3"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    }
}
